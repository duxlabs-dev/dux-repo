# Template file for 'dux-edit'
#
# Standalone Dux Labs text editor; installs the 'dux-edit' binary (and the
# 'dedit' alias) with the Quickshell UI embedded (-tags withshell).
pkgname=dux-edit
version=0.1.0
revision=1
build_style=go
build_wrksrc="core"
go_import_path="github.com/duxlabs-dev/dux-edit/core"
go_package="${go_import_path}/cmd/dux-edit"
go_build_tags="withshell"
go_ldflags="-X main.Version=${version}"
short_desc="Text and document editor for the Dux Labs desktop"
maintainer="Dux Labs <DuxLabsDev@gmail.com>"
license="MIT"
homepage="https://github.com/duxlabs-dev/dux-edit"
changelog="https://github.com/duxlabs-dev/dux-edit/releases"
# Release tarball ships the dux-qml-common submodule and vendored Go modules
distfiles="https://github.com/duxlabs-dev/dux-edit/releases/download/v${version}/dux-edit-${version}.tar.gz"
checksum=d106fee2fc37528b34d57dc17b2a8ab38fbcfd846bc34f36d02c408afce5d1d1
wrksrc="dux-edit-${version}"

depends="dux-qt-base>=0.4.3 qt6-declarative"

pre_build() {
	# go.mod needs Go 1.27, newer than Void's go; xbps-src defaults GOTOOLCHAIN to local.
	export GOTOOLCHAIN=auto
	# Embed the quickshell UI and build it into the binary. Mirrors 'make sync-shell',
	# which needs GNU tar (absent from the xbps-src masterdir).
	rm -rf internal/shellembed/dist
	cp -aL "${wrksrc}/quickshell" internal/shellembed/dist
	rm -rf internal/shellembed/dist/tests
	rm -f internal/shellembed/dist/.qmlls.ini internal/shellembed/dist/translations/extract_translations.py
}

post_install() {
	ln -sf dux-edit "${DESTDIR}/usr/bin/dedit"

	# Desktop integration (UI is embedded in the binary; no QML install)
	vinstall "${wrksrc}/assets/dev.duxlabs.edit.desktop" 644 usr/share/applications
	vinstall "${wrksrc}/assets/dev.duxlabs.edit.svg" 644 usr/share/icons/hicolor/scalable/apps
	vinstall "${wrksrc}/assets/dev.duxlabs.edit.metainfo.xml" 644 usr/share/metainfo
	vinstall "${wrksrc}/assets/dev.duxlabs.edit.policy" 644 usr/share/polkit-1/actions

	# Shell completions (generated by the built binary; skip when cross-building)
	vmkdir usr/share/bash-completion/completions
	vmkdir usr/share/zsh/site-functions
	vmkdir usr/share/fish/vendor_completions.d
	if [ -z "$CROSS_BUILD" ]; then
		"${DESTDIR}/usr/bin/dux-edit" completion bash > "${DESTDIR}/usr/share/bash-completion/completions/dux-edit"
		"${DESTDIR}/usr/bin/dux-edit" completion zsh  > "${DESTDIR}/usr/share/zsh/site-functions/_dux-edit"
		"${DESTDIR}/usr/bin/dux-edit" completion fish > "${DESTDIR}/usr/share/fish/vendor_completions.d/dux-edit.fish"
	fi

	vlicense "${wrksrc}/LICENSE"
}
