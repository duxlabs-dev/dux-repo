#!/usr/bin/make -f

export GOCACHE = $(CURDIR)/.cache/go-build
export GOPATH = $(CURDIR)/.go
export HOME = $(CURDIR)

DEB_VERSION := $(shell dpkg-parsechangelog -S Version)
UPSTREAM_VERSION := $(shell echo $(DEB_VERSION) | sed 's/\.db[0-9]*$$//' | sed 's/ppa[0-9]*$$//')
COMMIT_HASH := $(shell echo $(UPSTREAM_VERSION) | sed -n 's/.*\.\([a-f0-9]\{7,8\}\)$$/\1/p')
BUILD_TIME := $(shell date -u '+%Y-%m-%d_%H:%M:%S')

DEB_HOST_ARCH := $(shell dpkg-architecture -qDEB_HOST_ARCH)
GO_HOST_ARCH := $(if $(filter arm64,$(DEB_HOST_ARCH)),arm64,amd64)
export PATH := $(CURDIR)/.go-toolchain/$(GO_HOST_ARCH)/go/bin:$(PATH)

%:
	dh $@

override_dh_auto_build:
	# Embed the quickshell UI and build it into the binary.
	$(MAKE) -C core sync-shell
	cd core && \
		GOTOOLCHAIN=local CGO_ENABLED=0 go build -mod=vendor \
		-tags withshell \
		-ldflags="-s -w -X main.Version=$(UPSTREAM_VERSION) -X main.BuildTime=$(BUILD_TIME) -X main.Commit=$(COMMIT_HASH)" \
		-o ../dux-edit ./cmd/dux-edit
	mkdir -p completions
	./dux-edit completion bash > completions/dux-edit
	./dux-edit completion zsh > completions/_dux-edit
	./dux-edit completion fish > completions/dux-edit.fish

override_dh_auto_install:
	install -Dm755 dux-edit debian/dux-edit-git/usr/bin/dux-edit
	ln -sf dux-edit debian/dux-edit-git/usr/bin/dedit
	install -Dm644 assets/dev.duxlabs.edit.desktop \
		debian/dux-edit-git/usr/share/applications/dev.duxlabs.edit.desktop
	install -Dm644 assets/dev.duxlabs.edit.svg \
		debian/dux-edit-git/usr/share/icons/hicolor/scalable/apps/dev.duxlabs.edit.svg
	install -Dm644 assets/dev.duxlabs.edit.metainfo.xml \
		debian/dux-edit-git/usr/share/metainfo/dev.duxlabs.edit.metainfo.xml
	install -Dm644 assets/dev.duxlabs.edit.policy \
		debian/dux-edit-git/usr/share/polkit-1/actions/dev.duxlabs.edit.policy
	install -Dm644 completions/dux-edit \
		debian/dux-edit-git/usr/share/bash-completion/completions/dux-edit
	install -Dm644 completions/_dux-edit \
		debian/dux-edit-git/usr/share/zsh/site-functions/_dux-edit
	install -Dm644 completions/dux-edit.fish \
		debian/dux-edit-git/usr/share/fish/vendor_completions.d/dux-edit.fish

override_dh_auto_test:
	# Skip tests for git snapshot packaging

override_dh_auto_clean:
	rm -rf dux-edit completions .cache .go core/internal/shellembed/dist
	dh_auto_clean
