#!/usr/bin/make -f

export DEB_BUILD_MAINT_OPTIONS = hardening=+all

DEB_VERSION_UPSTREAM := $(shell dpkg-parsechangelog -S Version | sed 's/-[^-]*$$//')
GIT_REVISION := $(shell echo "$(DEB_VERSION_UPSTREAM)" | sed -n 's/.*+git[0-9]*\.\([a-f0-9]\{7,8\}\).*/\1/p')

%:
	dh $@ --buildsystem=cmake+ninja

override_dh_auto_configure:
	dh_auto_configure -- \
		-DCMAKE_BUILD_TYPE=RelWithDebInfo \
		-DDISTRIBUTOR="Debian (libdux-qt-base0-git)" \
		-DGIT_REVISION="$(if $(GIT_REVISION),$(GIT_REVISION),unknown)"

# BUILD_TESTING is off, so there is no test target
override_dh_auto_test:
	:
